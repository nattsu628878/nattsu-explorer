---
import { getCollection } from 'astro:content';
import MapView from '../components/MapView.svelte';
import '../styles/tokens.css';

const entries = await getCollection('spots');
const spots = entries.map((e) => ({
  slug: e.slug,
  lat: e.data.lat,
  lng: e.data.lng,
  date: e.data.date.toISOString().slice(0, 10),
  photo: e.data.photo,
  notes: e.data.notes ?? ''
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>nattsu-explorer</title>
    <style>
      html, body, #app {
        height: 100%;
      }
      body {
        margin: 0;
      }
      #app {
        height: 100vh;
        width: 100vw;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <div id="app">
      <MapView spots={spots} client:load />
    </div>
  </body>
</html>
